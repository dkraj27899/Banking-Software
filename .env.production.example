# === Database (used by both docker-compose and backend) ===
POSTGRES_DB=bccs_prod
POSTGRES_USER=bccs_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
DATABASE_URL=postgresql://bccs_prod:CHANGE_ME_strong_random_password@postgres:5432/bccs_prod
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# === Redis ===
REDIS_URL=redis://redis:6379

# === Auth ===
JWT_SECRET=CHANGE_ME_minimum_32_chars_random
JWT_REFRESH_SECRET=CHANGE_ME_minimum_32_chars_random_different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === App ===
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.bhagwatisociety.com
LOG_LEVEL=info

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# === Firebase ===
FIREBASE_PROJECT_ID=

# === Twilio (optional) ===
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SMS_ENABLED=false
